# Documentation only: npm start does not automatically read this file.
# Set variables in Render's Environment tab or your local shell.
PORT=4176
HOST=127.0.0.1
NODE_ENV=development

# Relative or absolute SQLite path. The directory is created automatically.
AI_EDUCATION_DATABASE_PATH=data/ai-education.sqlite
AI_EDUCATION_SEED_DEMO_ACCOUNTS=true
AI_EDUCATION_PUBLIC_DEMO=false

# Render: NODE_ENV=production, HOST=0.0.0.0, SEED_DEMO_ACCOUNTS=false,
# AI_EDUCATION_DATABASE_PATH=/var/data/ai-education.sqlite.
# PUBLIC_DEMO=false for team testing, true for the portfolio service.

# Optional settings for the five-learner end-to-end test.
AI_EDUCATION_E2E_DATABASE=runtime-data/system-e2e-review.sqlite
AI_EDUCATION_E2E_REPORT_DIR=runtime-data/test-reports
